---
import { ClientRouter } from 'astro:transitions'
const { title } = Astro.props
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title} · Astro example</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
    <!-- Reopens the consent banner, so visitors can change their decision. -->
    <footer><a id="cookie-settings" href="#ci-consent-settings">Cookie settings</a></footer>
    <script>
      // The recipe from the library README: report Astro view-transition navigations.
      import { initBrowserAnalytics } from '@clearideas/consent-analytics/browser'

      const analytics = initBrowserAnalytics(
        { apiBaseUrl: 'http://localhost:18787/', siteKey: 'demo-site' },
        { routeChanges: 'manual' },
      )
      document.addEventListener('astro:page-load', () => {
        analytics.notifyRouteChange()
        document
          .getElementById('cta')
          ?.addEventListener('click', () => analytics.trackEvent('cta_click', { framework: 'astro' }))
      })
    </script>
  </body>
</html>
