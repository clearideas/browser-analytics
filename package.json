{
  "name": "@clearideas/consent-analytics",
  "version": "0.1.1",
  "type": "module",
  "description": "Consent management and privacy-focused analytics for browser applications",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.mjs",
      "require": "./dist/nuxt.cjs"
    },
    "./nuxt.client": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.client.mjs",
      "require": "./dist/nuxt.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.mjs",
      "require": "./dist/next.cjs"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins.mjs",
      "require": "./dist/plugins.cjs"
    },
    "./script": "./dist/analytics.js",
    "./consent.css": "./dist/consent.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c --no-stdin && tsc --emitDeclarationOnly && node scripts/build-consent-css.mjs",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src test e2e sample-host/src sample-host/test",
    "lint:fix": "eslint --fix src test e2e sample-host/src sample-host/test",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' 'e2e/**/*.ts' 'sample-host/src/**/*.ts' 'sample-host/test/**/*.ts' && npm run lint:fix",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run check",
    "release": "npm version patch && npm publish",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run lint && npm run type-check && npm run test:coverage && npm run build && npm run check:package",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "playground": "npm run build && npm --prefix sample-host run dev",
    "examples:build": "node examples/build.mjs",
    "test:examples": "playwright test -c playwright.examples.config.ts"
  },
  "keywords": [
    "analytics",
    "consent",
    "cookie-banner",
    "gdpr",
    "nextjs",
    "nuxt",
    "privacy",
    "react",
    "tracking",
    "typescript",
    "vite"
  ],
  "author": "Clear Ideas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clearideas/consent-analytics.git"
  },
  "bugs": {
    "url": "https://github.com/clearideas/consent-analytics/issues"
  },
  "homepage": "https://github.com/clearideas/consent-analytics#readme",
  "peerDependencies": {
    "nuxt": "^3.0.0 || ^4.0.0",
    "react": ">=18.0.0",
    "next": ">=13.4.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.67.4",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.8.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  },
  "unpkg": "dist/analytics.js",
  "jsdelivr": "dist/analytics.js"
}
