{
  "name": "@clearideas/analytics",
  "version": "0.1.0",
  "type": "module",
  "description": "Privacy-focused analytics library for Nuxt and Vite applications",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.mjs",
      "require": "./dist/nuxt.cjs"
    },
    "./nuxt.client": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.mjs",
      "require": "./dist/nuxt.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c --no-stdin && tsc --emitDeclarationOnly",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "format": "prettier --write 'src/**/*.ts' && eslint --fix src",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run check",
    "release": "npm version patch && npm publish",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run lint && npm run type-check && npm test && npm run build && npm run check:package"
  },
  "keywords": [
    "analytics",
    "privacy",
    "gdpr",
    "nuxt",
    "vite",
    "typescript",
    "tracking"
  ],
  "author": "Clear Ideas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clearideas/browser-analytics.git"
  },
  "bugs": {
    "url": "https://github.com/clearideas/browser-analytics/issues"
  },
  "homepage": "https://github.com/clearideas/browser-analytics#readme",
  "peerDependencies": {
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.10",
    "rollup": "^4.68.2",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.8.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
